# ── LLM 제공자 ────────────────────────────────────────────────
# "anthropic" (Claude) 또는 "openai" (ChatGPT)
LLM_PROVIDER=anthropic

# Claude를 쓸 때 — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# 기본값은 claude-opus-5 (가장 똑똑함).
# 비용을 줄이려면 claude-sonnet-5 또는 claude-haiku-4-5 로 바꾸세요.
ANTHROPIC_MODEL=claude-opus-5

# ChatGPT를 쓸 때 — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1

# ── 게임 설정 ─────────────────────────────────────────────────
PORT=5173

# 한 턴에 LLM으로 "직접 사고"할 AI 국가 수.
# 나머지 국가는 규칙 기반 AI가 움직입니다.
# 높일수록 세계가 똑똑해지지만 턴당 비용과 시간이 늘어납니다.
# 플레이어와 관련 깊은 나라(교전국·접경국·동맹국·강대국)부터 자동 선택됩니다.
AI_THINKING_NATIONS=10

# 동시에 보낼 LLM 요청 수. 레이트 리밋에 걸리면 낮추세요.
AI_CONCURRENCY=4

GAME_LANGUAGE=ko
