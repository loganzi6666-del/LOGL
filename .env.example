# ── LLM 제공자 ────────────────────────────────────────────────
# "anthropic" (Claude) 또는 "openai" (ChatGPT). 기본값은 anthropic.
LLM_PROVIDER=anthropic

# Claude를 쓸 때 (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# ChatGPT를 쓸 때 (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1

# ── 게임 설정 ─────────────────────────────────────────────────
PORT=5173

# 한 턴에 LLM으로 "직접 사고"하게 만들 AI 국가 수.
# 나머지 국가는 규칙 기반 AI로 움직입니다. 높일수록 똑똑해지지만 비용이 늘어납니다.
AI_THINKING_NATIONS=10

# LLM 응답 언어
GAME_LANGUAGE=ko
