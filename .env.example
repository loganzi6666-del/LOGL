# ── 이 파일이 없어도 게임은 완전히 돌아갑니다 ──────────────────
# 키를 넣지 않으면 내장 한국어 명령 해석기가 지시를 알아듣습니다. 무료이고 즉시 반응합니다.
# 아래 설정은 "각 나라가 LLM으로 스스로 판단하게" 만들고 싶을 때만 필요합니다.

PORT=5173
GAME_LANGUAGE=ko

# ── 방법 1 (무료) · 내 컴퓨터에서 모델 돌리기 ─────────────────
# ollama.com 에서 Ollama를 설치하고 터미널에서:  ollama pull qwen2.5:7b
# 그다음 아래 세 줄의 주석(#)을 지우세요. 요금이 들지 않습니다.
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen2.5:7b

# ── 방법 2 (유료) · Claude ────────────────────────────────────
# https://console.anthropic.com/settings/keys
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5      # 저렴하게: claude-haiku-4-5

# ── 방법 3 (유료) · ChatGPT ───────────────────────────────────
# https://platform.openai.com/api-keys
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4.1

# ── AI 사용량 조절 ────────────────────────────────────────────
# 한 턴에 LLM으로 직접 사고할 국가 수. 낮출수록 빠르고 저렴합니다.
AI_THINKING_NATIONS=6
AI_CONCURRENCY=4
