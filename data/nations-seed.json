  "AT": { "pop": 9100000, "gdp": 516, "act": 22500, "res": 125000, "bud": 3.9, "nuk": 0, "gov": "연방 의원내각제 공화국", "blocs": ["EU"], "doc": "헌법상 영세중립국. EU 회원이지만 NATO에는 가입하지 않는다." },
