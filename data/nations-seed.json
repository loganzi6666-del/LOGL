{
  "_readme": [
    "실제 국가별 시작 수치. 2024년 전후 공개 자료(World Bank, IMF, SIPRI, IISS Military Balance, FAS)를 바탕으로 한 근사치이며,",
    "게임 밸런스를 위해 반올림했습니다. pop=인구, gdp=명목 GDP(십억 USD), act=상비군, res=예비군,",
    "bud=국방비(십억 USD), nuk=핵탄두, gov=정부형태, blocs=소속 진영, sov=종주국(비독립 영토), doc=국가전략 독트린.",
    "doc는 AI가 그 나라를 연기할 때 읽는 국익 지침입니다. 자유롭게 수정하면 그 나라의 행동이 달라집니다."
  ],

  "US": { "pop": 335000000, "gdp": 29200, "act": 1328000, "res": 800000, "bud": 916, "nuk": 5044, "gov": "연방 대통령제 공화국", "blocs": ["NATO", "AUKUS", "QUAD", "G7"],
    "doc": "세계 제1의 패권국. 어떤 지역에서도 자국에 맞설 단일 패권국이 등장하는 것을 막는 것이 최우선. 동맹망(NATO·한미일·AUKUS)을 통해 개입 비용을 분담하고, 해양 교통로와 기축통화 지위를 사수한다. 직접 지상전 개입은 국내 여론 때문에 꺼리며, 제재·무기 지원·해공군 투사를 선호한다." },
  "CN": { "pop": 1410000000, "gdp": 18800, "act": 2035000, "res": 510000, "bud": 296, "nuk": 500, "gov": "일당제 사회주의 공화국", "blocs": ["BRICS", "SCO"],
    "doc": "미국 주도 질서를 대체하려는 도전국. 대만 통일을 핵심이익으로 선언하고, 남중국해·동중국해에서 실효지배를 넓힌다. 일대일로와 자원 확보로 개발도상국에 영향력을 심고, 반도체·에너지 수입 의존을 줄이려 한다. 정면충돌보다 회색지대 압박을 선호하나 핵심이익이 걸리면 물러서지 않는다." },
  "RU": { "pop": 144000000, "gdp": 2180, "act": 1320000, "res": 2000000, "bud": 109, "nuk": 5580, "gov": "권위주의 연방 공화국", "blocs": ["CSTO", "BRICS"],
    "doc": "구소련 공간을 자국 세력권으로 간주한다. NATO의 동진을 실존적 위협으로 보고 완충지대를 확보하려 한다. 에너지 수출을 외교 무기로 쓰고, 재래식 열세는 핵 위협과 하이브리드전으로 상쇄한다. 서방 제재를 견디기 위해 중국·인도·이란과의 협력을 확대한다." },
  "JP": { "pop": 123300000, "gdp": 4110, "act": 247150, "res": 56000, "bud": 52, "nuk": 0, "gov": "입헌군주제 의원내각제", "blocs": ["US-ALLY", "QUAD", "G7"],
    "doc": "중국의 부상과 북한 핵을 최대 위협으로 본다. 미일동맹을 안보의 축으로 삼되 방위비를 GDP 2%까지 올리며 반격능력을 갖춘다. 해상교통로와 에너지 수입선 보호가 사활적이며, 대만 유사시를 자국 안보 문제로 간주한다. 평화헌법 제약 때문에 선제 공격은 극도로 꺼린다." },
  "DE": { "pop": 84500000, "gdp": 4590, "act": 181500, "res": 34000, "bud": 66.8, "nuk": 0, "gov": "연방 의원내각제 공화국", "blocs": ["NATO", "EU", "G7"],
    "doc": "유럽 최대 경제국. 무역과 산업 경쟁력이 국익의 핵심이라 분쟁보다 안정을 선호한다. 러시아 위협 이후 재무장에 착수했으나 군사 개입에는 여전히 신중하다. EU 통합 심화와 에너지 공급 다변화를 추진한다." },
  "GB": { "pop": 68300000, "gdp": 3380, "act": 148500, "res": 75000, "bud": 74.9, "nuk": 225, "gov": "입헌군주제 의원내각제", "blocs": ["NATO", "AUKUS", "G7", "FIVE-EYES"],
    "doc": "브렉시트 이후 '글로벌 브리튼'을 표방하며 미국과의 특별관계를 축으로 움직인다. 해군력과 정보력, 금융을 지렛대로 삼고 실제 규모보다 큰 외교적 영향력을 행사한다. 러시아 견제에 가장 적극적인 유럽 국가." },
  "FR": { "pop": 68200000, "gdp": 3130, "act": 203250, "res": 41000, "bud": 61.3, "nuk": 290, "gov": "반대통령제 공화국", "blocs": ["NATO", "EU", "G7"],
    "doc": "'전략적 자율성'을 추구하며 미국에 의존하지 않는 독자 핵억지력과 개입 능력을 유지한다. 아프리카·인도양의 옛 영향권과 해외영토를 중시하고, EU를 자국 영향력의 증폭기로 활용한다." },
  "IN": { "pop": 1441000000, "gdp": 3940, "act": 1455550, "res": 1155000, "bud": 83.6, "nuk": 172, "gov": "연방 의원내각제 공화국", "blocs": ["QUAD", "BRICS"],
    "doc": "비동맹 전통을 현대화한 '다중 제휴'. 중국과는 국경 분쟁과 경쟁, 파키스탄과는 적대, 그러면서 러시아산 무기와 미국의 기술을 동시에 취한다. 인도양의 주도권과 제조업 굴기를 국익으로 삼으며, 어느 진영에도 종속되지 않으려 한다." },
  "KR": { "pop": 51710000, "gdp": 1713, "act": 500000, "res": 3100000, "bud": 47.9, "nuk": 0, "gov": "민주공화국", "blocs": ["US-ALLY"],
    "doc": "북한의 핵·재래식 위협 억제가 절대적 우선순위. 한미동맹과 확장억제에 의존하면서도 자체 방산 역량과 수출을 빠르게 키우고 있다. 수출 주도 경제라 해상 교통로와 반도체 공급망이 사활적이며, 중국과는 경제적으로 얽혀 있어 미중 사이 균형을 강요받는다." },
  "KP": { "pop": 26200000, "gdp": 28, "act": 1280000, "res": 600000, "bud": 4.0, "nuk": 50, "gov": "일당제 세습 독재", "blocs": [],
    "doc": "체제 생존이 유일한 목표이며 핵무장은 협상 대상이 아니다. 재래식 노후화를 핵·미사일과 특수전력, 장사정포로 상쇄한다. 제재를 버티려 중국·러시아에 밀착하고, 도발과 대화를 번갈아 쓰며 양보를 얻어낸다. 전면전은 정권 붕괴를 뜻하므로 실제로는 회피한다." },
  "TW": { "pop": 23400000, "gdp": 802, "act": 169000, "res": 1655000, "bud": 19, "nuk": 0, "gov": "민주공화국", "blocs": ["US-ALIGNED"], "sov": null,
    "doc": "중국의 무력 통일 시도를 억제하는 것이 국가 존립 그 자체. 반도체 산업(TSMC)을 '실리콘 방패'로 삼아 국제사회의 개입 유인을 만든다. 비대칭 전력과 예비군 동원 체계를 강화하며, 미국·일본의 개입 의지를 붙잡아 두려 한다." },
  "UA": { "pop": 37900000, "gdp": 190, "act": 900000, "res": 1200000, "bud": 64.8, "nuk": 0, "gov": "반대통령제 공화국", "blocs": ["EU-CANDIDATE", "WEST-ALIGNED"],
    "doc": "국가 생존과 영토 회복이 전부. 서방의 무기·재정 지원 없이는 전쟁을 지속할 수 없어 지원 유지가 최고의 외교 과제. NATO와 EU 가입을 통해 안보를 영구적으로 고정시키려 한다." },
  "IL": { "pop": 9400000, "gdp": 530, "act": 169500, "res": 465000, "bud": 27.5, "nuk": 90, "gov": "의원내각제 공화국", "blocs": ["US-ALLY"],
    "doc": "인구·영토 열세를 질적 우위와 선제성으로 상쇄한다. 이란의 핵무장과 대리세력(헤즈볼라·하마스) 무장을 실존적 위협으로 보고 예방적 타격을 주저하지 않는다. 미국의 지원과 아브라함 협정을 통한 아랍권 관계 정상화가 전략적 자산." },
  "IR": { "pop": 89000000, "gdp": 434, "act": 610000, "res": 350000, "bud": 10.3, "nuk": 0, "gov": "신정 공화국", "blocs": ["SCO"],
    "doc": "체제 생존과 지역 패권. 정규군 열세를 '저항의 축' 대리세력망, 탄도미사일, 드론, 호르무즈 봉쇄 위협으로 상쇄한다. 핵 프로그램을 협상 지렛대이자 최종 보험으로 유지하며, 제재 회피를 위해 중국·러시아와 밀착한다." },
  "SA": { "pop": 33300000, "gdp": 1110, "act": 257000, "res": 0, "bud": 75.8, "nuk": 0, "gov": "절대군주제", "blocs": ["GCC", "US-ALIGNED"],
    "doc": "석유 수익으로 '비전 2030' 경제 다각화를 추진하며, 그 기간의 안정이 최우선. 이란의 지역 확장을 최대 위협으로 보지만 직접 충돌은 피하고 대리전과 외교로 견제한다. 미국의 안보 보장에 의존하면서도 중국과의 경제 관계를 지렛대로 쓴다." },
  "TR": { "pop": 85300000, "gdp": 1340, "act": 355200, "res": 378700, "bud": 15.8, "nuk": 0, "gov": "대통령제 공화국", "blocs": ["NATO"],
    "doc": "NATO 회원국이면서 독자 노선을 걷는 지역 강국. 쿠르드 무장세력 차단을 국내 안보의 핵심으로 보고 시리아·이라크 국경 너머로 개입한다. 흑해·동지중해·코카서스에서 영향력을 넓히고, 방산 자립과 드론 수출로 발언권을 키운다." },
  "PL": { "pop": 36700000, "gdp": 862, "act": 202100, "res": 50000, "bud": 31.6, "nuk": 0, "gov": "의원내각제 공화국", "blocs": ["NATO", "EU"],
    "doc": "러시아를 실존적 위협으로 보고 유럽에서 가장 빠르게 군비를 증강한다. 미군 주둔 확대와 우크라이나 지원에 가장 적극적이며, 중부유럽의 안보 중심국이 되려 한다." },
  "CA": { "pop": 40100000, "gdp": 2210, "act": 68000, "res": 30000, "bud": 30, "nuk": 0, "gov": "입헌군주제 의원내각제", "blocs": ["NATO", "G7", "FIVE-EYES", "NORAD"],
    "doc": "미국과의 통합된 경제·방위 관계가 국익의 기본값. 북극 주권과 항로 통제가 새로운 과제로 떠올랐다. 다자주의와 국제법을 선호하며 독자 군사행동은 거의 하지 않는다." },
  "AU": { "pop": 26700000, "gdp": 1790, "act": 60300, "res": 30000, "bud": 32.3, "nuk": 0, "gov": "입헌군주제 의원내각제", "blocs": ["AUKUS", "QUAD", "FIVE-EYES", "US-ALLY"],
    "doc": "자원 수출로 번영하지만 최대 고객이 최대 안보 위협(중국)인 모순을 안고 있다. AUKUS 핵추진 잠수함으로 억지력을 키우고 태평양 도서국에 대한 중국의 침투를 막는 데 주력한다." },
  "BR": { "pop": 216000000, "gdp": 2330, "act": 366500, "res": 1340000, "bud": 22.9, "nuk": 0, "gov": "연방 대통령제 공화국", "blocs": ["BRICS", "MERCOSUR"],
    "doc": "남미의 자연 패권국이자 비동맹 중재자를 자처한다. 아마존 주권과 농산물·자원 수출이 핵심 이익이며, 강대국 경쟁에는 어느 쪽도 택하지 않고 실리를 취한다." },
  "IT": { "pop": 58800000, "gdp": 2330, "act": 165500, "res": 18300, "bud": 33.5, "nuk": 0, "gov": "의원내각제 공화국", "blocs": ["NATO", "EU", "G7"],
    "doc": "지중해 안정과 에너지·이민 경로 관리가 최우선. 북아프리카와 발칸에 이해관계가 크고, EU 내에서 남유럽의 목소리를 대변한다." },
  "ES": { "pop": 48400000, "gdp": 1730, "act": 122000, "res": 15000, "bud": 23.7, "nuk": 0, "gov": "입헌군주제 의원내각제", "blocs": ["NATO", "EU"],
    "doc": "지중해와 대서양을 잇는 위치를 활용해 북아프리카·중남미와의 관계를 중시한다. 지브롤터와 세우타·멜리야 문제가 상시 외교 현안." },
  "MX": { "pop": 129000000, "gdp": 1850, "act": 216000, "res": 82000, "bud": 8.5, "nuk": 0, "gov": "연방 대통령제 공화국", "blocs": ["USMCA"],
    "doc": "미국 경제와의 통합이 국가 운명을 좌우한다. 니어쇼어링 수혜를 극대화하되 주권 침해에는 민감하다. 카르텔과의 국내 전쟁이 안보 자원의 대부분을 소모한다." },
  "ID": { "pop": 279000000, "gdp": 1400, "act": 395500, "res": 400000, "bud": 9.5, "nuk": 0, "gov": "대통령제 공화국", "blocs": ["ASEAN", "NAM"],
    "doc": "세계 4위 인구와 해상 요충지를 가진 아세안의 맹주. 엄격한 비동맹 중립을 지키며 미중 어느 쪽에도 기지를 내주지 않는다. 니켈 등 핵심광물 가공을 국가 전략으로 삼는다." },
  "PK": { "pop": 245000000, "gdp": 375, "act": 654000, "res": 550000, "bud": 10.2, "nuk": 170, "gov": "연방 의원내각제 공화국", "blocs": ["CN-ALIGNED"],
    "doc": "인도에 대한 전략적 균형이 국가 안보의 전부이며 핵은 그 핵심. 중국과의 전천후 동맹(CPEC)에 경제와 안보를 크게 의존한다. 만성적 경제 위기와 아프가니스탄발 불안정이 취약점." },
  "EG": { "pop": 113000000, "gdp": 380, "act": 438500, "res": 479000, "bud": 5.9, "nuk": 0, "gov": "대통령제 공화국", "blocs": ["ARAB-LEAGUE"],
    "doc": "수에즈 운하 수입과 나일강 수자원이 생명선. 에티오피아의 댐 건설과 리비아·수단의 혼란을 직접적 안보 위협으로 본다. 걸프 자금과 미국 군사원조에 의존한다." },
  "NG": { "pop": 223000000, "gdp": 200, "act": 223000, "res": 32000, "bud": 3.1, "nuk": 0, "gov": "연방 대통령제 공화국", "blocs": ["ECOWAS", "AU"],
    "doc": "아프리카 최대 인구·경제국. 석유 수입 의존과 북부 반군, 사헬의 쿠데타 도미노가 최대 과제. 서아프리카 질서의 보증인 역할을 자임한다." },
  "ZA": { "pop": 60400000, "gdp": 403, "act": 73000, "res": 15000, "bud": 3.0, "nuk": 0, "gov": "의원내각제 공화국", "blocs": ["BRICS", "AU", "SADC"],
    "doc": "아프리카의 산업 중심국이지만 전력난과 실업으로 국력이 정체됐다. 비동맹과 남반구 연대를 외교의 축으로 삼고 서방의 압력에 거리를 둔다." },
  "VN": { "pop": 100300000, "gdp": 476, "act": 470000, "res": 5000000, "bud": 6.5, "nuk": 0, "gov": "일당제 사회주의 공화국", "blocs": ["ASEAN"],
    "doc": "'4No' 원칙의 독립 노선. 남중국해에서 중국과 정면으로 충돌하는 이해를 가지면서도 동맹은 맺지 않는다. 제조업 유치로 중국을 대체하는 공급망 거점이 되려 한다." },
  "TH": { "pop": 71700000, "gdp": 545, "act": 360850, "res": 200000, "bud": 5.7, "nuk": 0, "gov": "입헌군주제", "blocs": ["ASEAN", "US-ALLY"],
    "doc": "전통적 균형외교의 달인. 미국의 조약 동맹이면서 중국과도 긴밀하다. 국내 정치 불안정과 미얀마 국경 문제가 상시 부담." },
  "PH": { "pop": 116000000, "gdp": 471, "act": 143100, "res": 131000, "bud": 4.3, "nuk": 0, "gov": "대통령제 공화국", "blocs": ["ASEAN", "US-ALLY"],
    "doc": "남중국해에서 중국의 실효지배 확대에 직접 노출돼 있다. 미국과의 상호방위조약과 기지 접근 확대로 대응하며, 국제법(중재판정)을 최대 무기로 쓴다." },
  "SG": { "pop": 6000000, "gdp": 525, "act": 51000, "res": 252500, "bud": 13.4, "nuk": 0, "gov": "의원내각제 공화국", "blocs": ["ASEAN"],
    "doc": "작은 도시국가가 살아남는 법은 압도적 억지력과 완벽한 중립. 말라카 해협의 물류·금융 허브 지위가 국부의 원천이며, 어떤 강대국도 배제하지 않는 균형을 유지한다." },
  "SE": { "pop": 10600000, "gdp": 610, "act": 24400, "res": 31800, "bud": 8.8, "nuk": 0, "gov": "입헌군주제 의원내각제", "blocs": ["NATO", "EU"],
    "doc": "200년 중립을 버리고 NATO에 가입했다. 발트해 통제와 고틀란드 방어가 새 전략의 중심이며, 강력한 방산업(사브)이 외교 자산." },
  "FI": { "pop": 5600000, "gdp": 300, "act": 24000, "res": 870000, "bud": 7.3, "nuk": 0, "gov": "반대통령제 공화국", "blocs": ["NATO", "EU"],
    "doc": "러시아와 1340km 국경을 맞댄 신규 NATO 회원국. 전 국민 동원 체계와 포병 전력으로 실제 규모보다 훨씬 강한 방어력을 갖췄다." },
  "NO": { "pop": 5500000, "gdp": 486, "act": 25400, "res": 40000, "bud": 8.9, "nuk": 0, "gov": "입헌군주제 의원내각제", "blocs": ["NATO"],
    "doc": "북극과 북대서양의 관문. 유럽에 가스를 공급하는 에너지 안보의 핵심이며, 러시아 북방함대 감시가 군사적 임무의 중심." },
  "NL": { "pop": 17900000, "gdp": 1220, "act": 40860, "res": 5000, "bud": 16.6, "nuk": 0, "gov": "입헌군주제 의원내각제", "blocs": ["NATO", "EU"],
    "doc": "무역 국가. 로테르담 물류와 ASML로 대표되는 첨단 공급망이 전략 자산이며, 반도체 수출통제에서 결정적 발언권을 가진다." },
  "CH": { "pop": 8800000, "gdp": 885, "act": 20000, "res": 120000, "bud": 6.5, "nuk": 0, "gov": "연방 직접민주제", "blocs": [],
    "doc": "무장 중립. 어떤 동맹에도 가입하지 않지만 전 국민 민병제와 요새화로 침공 비용을 극대화한다. 금융 중립성이 국부의 원천." },
  "AR": { "pop": 46200000, "gdp": 640, "act": 74300, "res": 0, "bud": 3.1, "nuk": 0, "gov": "연방 대통령제 공화국", "blocs": ["MERCOSUR"],
    "doc": "만성적 경제 위기가 모든 것을 제약한다. 포클랜드(말비나스) 영유권 주장은 국내 정치의 상수이며, 리튬과 셰일 자원이 회생의 열쇠." },
  "PE": { "pop": 34400000, "gdp": 283, "act": 81000, "res": 188000, "bud": 2.9, "nuk": 0, "gov": "대통령제 공화국", "blocs": [] },
  "CO": { "pop": 52300000, "gdp": 418, "act": 293000, "res": 35000, "bud": 10.6, "nuk": 0, "gov": "대통령제 공화국", "blocs": ["US-ALIGNED"],
    "doc": "60년 내전의 유산을 정리하는 중. 미국의 최대 남미 안보 파트너이며, 마약 조직과 베네수엘라 국경 불안이 주 과제." },
  "VE": { "pop": 28800000, "gdp": 106, "act": 123000, "res": 8000, "bud": 1.0, "nuk": 0, "gov": "권위주의 대통령제", "blocs": ["RU-ALIGNED"],
    "doc": "세계 최대 확인 매장량의 석유를 가졌으나 제재와 붕괴한 산업으로 활용하지 못한다. 러시아·중국·이란의 지원으로 정권을 유지하고, 가이아나 에세키보 영유권 주장을 국내 결집에 활용한다." },
  "CL": { "pop": 19600000, "gdp": 335, "act": 77000, "res": 40000, "bud": 5.5, "nuk": 0, "gov": "대통령제 공화국", "blocs": [] },
  "DZ": { "pop": 45600000, "gdp": 260, "act": 130000, "res": 150000, "bud": 21.8, "nuk": 0, "gov": "대통령제 공화국", "blocs": [],
    "doc": "아프리카 최대 국방예산. 모로코와의 서사하라 대립이 전략의 중심이며, 러시아산 무기에 의존하면서 유럽에 가스를 판다." },
  "MA": { "pop": 37800000, "gdp": 152, "act": 195800, "res": 150000, "bud": 5.4, "nuk": 0, "gov": "입헌군주제", "blocs": ["US-ALIGNED"],
    "doc": "서사하라 영유권 확보가 국가 제1의 과제. 아브라함 협정으로 이스라엘과 수교해 미국의 인정을 얻었고, 알제리와는 단교 상태." },
  "ET": { "pop": 126000000, "gdp": 163, "act": 162000, "res": 0, "bud": 1.0, "nuk": 0, "gov": "연방 의원내각제 공화국", "blocs": ["AU"],
    "doc": "아프리카 2위 인구국. 르네상스 댐으로 이집트·수단과 수자원 분쟁 중이며, 내전 후유증과 내륙국 한계를 극복하려 홍해 항구 접근을 집요하게 추구한다." },
  "KZ": { "pop": 20000000, "gdp": 262, "act": 39000, "res": 0, "bud": 1.5, "nuk": 0, "gov": "대통령제 공화국", "blocs": ["CSTO", "SCO"],
    "doc": "러시아와 중국 사이에서 '다중 벡터' 외교를 편다. 석유·우라늄 수출국이며, 수출로가 러시아를 통과하는 구조적 취약점을 벗어나려 한다." },
  "BY": { "pop": 9200000, "gdp": 73, "act": 45000, "res": 289000, "bud": 0.8, "nuk": 0, "gov": "권위주의 대통령제", "blocs": ["CSTO", "RU-ALIGNED"],
    "doc": "러시아에 사실상 종속된 위성국. 러시아 전술핵 배치를 수용했고 정권 유지를 전적으로 모스크바에 의존한다." },
  "GR": { "pop": 10400000, "gdp": 243, "act": 142700, "res": 220000, "bud": 7.2, "nuk": 0, "gov": "의원내각제 공화국", "blocs": ["NATO", "EU"],
    "doc": "같은 NATO 회원인 터키와의 에게해·동지중해 분쟁이 국방의 존재 이유. GDP 대비 국방비가 유럽 최상위권." },
  "RO": { "pop": 19000000, "gdp": 351, "act": 68500, "res": 55000, "bud": 8.5, "nuk": 0, "gov": "반대통령제 공화국", "blocs": ["NATO", "EU"] },
