  "DK": { "pop": 5900000, "gdp": 407, "act": 17200, "res": 12000, "bud": 8.1, "nuk": 0, "gov": "입헌군주제 의원내각제", "blocs": ["NATO", "EU"],
    "doc": "그린란드와 페로 제도를 통해 북극 강국의 지위를 가진다. 북극 항로와 자원이 열리면서 그 전략적 가치가 급상승했다." },
  "IE": { "pop": 5300000, "gdp": 545, "act": 7500, "res": 1700, "bud": 1.3, "nuk": 0, "gov": "의원내각제 공화국", "blocs": ["EU"], "doc": "군사적 중립국. 다국적 기업 유치로 번영하며 안보는 사실상 영국·NATO에 무임승차한다." },
  "RS": { "pop": 6600000, "gdp": 81, "act": 28000, "res": 50000, "bud": 1.6, "nuk": 0, "gov": "의원내각제 공화국", "blocs": ["RU-FRIENDLY"],
